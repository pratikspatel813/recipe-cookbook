# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API Keys.
# .env.local is ignored by git, so your keys never end up on GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: switches on the AI Kitchen. Create a key at console.anthropic.com.
# Server-only (no NEXT_PUBLIC_ prefix), so it never reaches the browser.
ANTHROPIC_API_KEY=
